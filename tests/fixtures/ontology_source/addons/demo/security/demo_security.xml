<odoo>
  <data noupdate="1">
    <record id="group_demo_user" model="res.groups">
      <field name="name">Demo User</field>
    </record>
    <record id="demo_order_acl" model="ir.model.access">
      <field name="name">demo.order acl</field>
      <field name="model_id" ref="model_demo_order"/>
      <field name="group_id" ref="group_demo_user"/>
      <field name="perm_read" eval="1"/>
    </record>
    <record id="demo_order_rule" model="ir.rule">
      <field name="name">Own orders</field>
      <field name="model_id" ref="model_demo_order"/>
      <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
  </data>
</odoo>
